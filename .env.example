# ---------------------------------------------------------------------------
# TrustGate Enterprise Gateway Configuration
# ---------------------------------------------------------------------------

# 1. API Keys (Only GEMINI_API_KEY is required for default operation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: plug-and-play for multi-provider deployment
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here

# 2. Logical Model Tiers (Default: Gemini Cascade)
MODEL_PRIMARY=gemini/gemini-3.8-flash
MODEL_SECONDARY=gemini/gemini-3.5-flash-lite
MODEL_TERTIARY=gemini/gemini-3.1-flash-lite

# 3. In-Memory Semantic Cache
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_MAX_ENTRIES=1000
CACHE_TTL_SECONDS=86400

# 4. Optional Langfuse Cloud Observability
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# 5. Network & SSL Settings (Optional)
# Set to 'false' ONLY if behind a corporate proxy that intercepts certificates
# SSL_VERIFY=true
